    "react-hook-form": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.21.0",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.7.3"
  }
