{
  "name": "cowin-machine",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:source-products": "node scripts/audit-source-products.mjs",
    "catalog:build": "node scripts/build-authorized-product-catalog.mjs",
    "check:public-boundary": "node scripts/public-boundary-guard.mjs",
    "check:content-similarity": "node scripts/content-similarity-guard.mjs",
    "check:site-visuals": "node scripts/check-site-visual-usage.mjs",
    "report:migration": "node scripts/generate-migration-reports.mjs",
    "content:schedule": "node scripts/run-content-automation.mjs",
    "content:validate": "node scripts/validate-content-automation.mjs",
    "prebuild": "pnpm run check:public-boundary && pnpm run check:content-similarity && pnpm run check:site-visuals"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@phosphor-icons/react": "^2.1.10",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.21.0",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.7.3"
  }
}
